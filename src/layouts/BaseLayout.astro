---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SangerAnalyst — Free Online Sanger Sequencing Analysis (.ab1)',
  description = 'Free online Sanger sequencing analysis: upload .ab1 forward & reverse reads for quality trimming, read merging, heterozygote detection and primer trimming.',
} = Astro.props;

// Base-path aware helpers: GitHub Pages serves under /sangeranalyst/
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => new URL(import.meta.env.BASE_URL + path, Astro.site).href;
const canonical = withBase('');
const ogImage = withBase('assets/og-image.png');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'SangerAnalyst',
      url: canonical,
      image: ogImage,
      applicationCategory: 'ScienceApplication',
      operatingSystem: 'Any (web browser)',
      description,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'AB1 chromatogram upload and analysis',
        "Mott quality trimming",
        'Forward–reverse read merging with quality-weighted consensus',
        'Heterozygote detection via secondary peaks (IUPAC ambiguity codes)',
        'Primer and off-target region trimming',
        'Conflict reporting between forward and reverse reads',
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What file types does SangerAnalyst support?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Applied Biosystems .ab1 chromatogram files for the forward and reverse reads. Primers are optional and can be uploaded as FASTA (.fasta/.fa/.txt) or pasted directly as sequence text.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is SangerAnalyst free to use?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes — SangerAnalyst is completely free and requires no account or installation. Upload your chromatograms and download the results.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does SangerAnalyst merge forward and reverse reads?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Reads are trimmed with Mott's algorithm, oriented automatically, aligned, and combined into a quality-weighted consensus. Sequencing errors are corrected from the higher-quality strand, and the overlap is statistically validated before a high-confidence consensus is produced.",
          },
        },
        {
          '@type': 'Question',
          name: 'Can SangerAnalyst detect heterozygotes or mixed templates?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Secondary peaks above your threshold that corroborate a forward–reverse disagreement are called as IUPAC ambiguity codes (R, Y, K, M, S, W) in the consensus, following PolyPhred-style mutation-detection practice.',
          },
        },
        {
          '@type': 'Question',
          name: 'Does it work with longer amplicons like 16S rRNA (~1,500 bp)?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. With ~900 bp forward and reverse reads sharing ~300 bp of overlap, the High-Confidence Consensus covers the validated overlap while the Full Merge output reconstructs the entire ~1,500 bp span. Primer trimming then yields the longest methodologically reliable sequence.',
          },
        },
        {
          '@type': 'Question',
          name: 'Do I need to install anything?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. SangerAnalyst is a web tool — open the page, drop in your chromatograms, and download the results. Nothing to install or configure.',
          },
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Sanger sequencing analysis, ab1 file analysis, chromatogram viewer, forward reverse consensus, heterozygote detection Sanger, Mott trimming, primer trimming, 16S Sanger analysis, free sequencing tool, DNA sequencing software, bioinformatics tool"
    />
    <meta name="author" content="SangerAnalyst" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Icons -->
    <link rel="icon" type="image/png" href={`${b}/favicon.png`} sizes="96x96" />
    <link rel="shortcut icon" href={`${b}/favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${b}/assets/apple-touch-icon.png`} />
    <link rel="manifest" href={`${b}/assets/site.webmanifest`} />
    <meta name="apple-mobile-web-app-title" content="SangerAnalyst" />

    <!-- Open graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SangerAnalyst" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <slot />
  </body>
</html>
